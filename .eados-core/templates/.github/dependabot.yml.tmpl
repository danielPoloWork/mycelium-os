# Dependabot for {{PROJECT_NAME}} (generated by EADOS).
# Keeps GitHub Actions and language dependencies current. Each update opens a PR that goes
# through the normal review/CI flow — Dependabot proposes, the maintainer merges.
#
# `groups` + `open-pull-requests-limit` are deliberate (#350). Ungrouped weekly bumps open one PR
# per dependency, and Dependabot's default cap is 5 per ecosystem — so a fresh repo could sit at 10
# concurrent bot PRs. One grouped PR per ecosystem per week is better hygiene and honest about the
# review it actually gets. The policy side is fixed too: `docs/workflow/git-policy.yaml`'s one-PR
# rule counts authored PRs only, so this bounds the noise rather than papering over a contradiction.
#
# NOTE on `labels:` — a label must already exist in the repository or GitHub drops it SILENTLY.
# These ship in `.github/labels.yml`; import them (docs/workflow/github-setup.md §5) BEFORE the
# first Dependabot run, or the first bot PRs arrive unlabelled with no error reported anywhere.
version: 2
updates:
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 1
    groups:
      github-actions:
        patterns: ["*"]
    commit-message:
      prefix: "ci"
    labels: ["ci"]
{{#IF_PKG_ECOSYSTEM}}  - package-ecosystem: "{{PKG_ECOSYSTEM}}"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 1
    groups:
      project-dependencies:
        patterns: ["*"]
    commit-message:
      prefix: "build"
    labels: ["build"]
{{/IF_PKG_ECOSYSTEM}}