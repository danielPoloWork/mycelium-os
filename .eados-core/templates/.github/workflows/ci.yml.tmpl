name: ci

# Enterprise CI gate for {{PROJECT_NAME}}, generated by EADOS.
# Implements the quality bar in AGENTS.md §10 across the toolchain matrix from the
# language profile. The build/test/format/lint commands come from project.yaml; the
# setup steps and language-specific extra jobs come from the profile.

on:
  pull_request:
  push:
    branches: [{{DEFAULT_BRANCH}}]
  workflow_call:

permissions:
  contents: read

# Cancel superseded runs on a PR; never cancel a run on {{DEFAULT_BRANCH}} (its history matters).
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
{{#IF_BOOTSTRAP_GUARD}}  # ---------------------------------------------------------------------------
  # Bootstrap guard (#313). Roadmap item 1.1 lays down the build system; until it lands there
  # is nothing for the toolchain jobs to build, so they SKIP rather than fail. A wall of red on
  # the bootstrap PR is not just noise — it teaches that red CI on this repo is normal, which is
  # the opposite of what every other gate here is for. The moment `{{CI_BUILD_MANIFEST}}` exists
  # every job below runs for real, with no edit to this workflow or to the profile.
  # ---------------------------------------------------------------------------
  bootstrap:
    name: bootstrap / is the build system in place?
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    outputs:
      ready: ${{ steps.probe.outputs.ready }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: probe
        shell: bash
        run: |
          # compgen -G matches a literal name AND a glob, so a profile may declare either.
          if compgen -G "{{CI_BUILD_MANIFEST}}" > /dev/null; then
            echo "ready=true" >> "$GITHUB_OUTPUT"
          else
            echo "ready=false" >> "$GITHUB_OUTPUT"
            echo "::notice title=Bootstrap pending::{{CI_BUILD_MANIFEST}} is not present yet, so the toolchain jobs are skipped. They start running by themselves once roadmap item 1.1 lands the build system."
          fi

{{/IF_BOOTSTRAP_GUARD}}  # ---------------------------------------------------------------------------
  # Cross-platform build + test matrix (from the language profile).
  # ---------------------------------------------------------------------------
  build:
    name: build / ${{ matrix.os }} / ${{ matrix.toolchain }} / ${{ matrix.preset }}
{{#IF_BOOTSTRAP_GUARD}}    needs: bootstrap
    if: needs.bootstrap.outputs.ready == 'true'
{{/IF_BOOTSTRAP_GUARD}}    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        include:
{{#EACH_CI_CELL}}          - { os: {{os}}, toolchain: {{toolchain}}, preset: {{preset}} }
{{/EACH_CI_CELL}}    steps:
      - name: Check out the source tree
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      {{CI_SETUP_STEPS}}

      - name: Build
        shell: bash
        run: {{CMD_BUILD}}

      - name: Test
        shell: bash
        run: {{CMD_TEST}}

  # ---------------------------------------------------------------------------
  # Cross-artifact congruence — the agent-runnable consistency lint.
  # ---------------------------------------------------------------------------
  consistency:
    name: consistency / lint
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0          # i18n/version checks need full history
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Run the consistency lint
        run: python tools/consistency_lint.py

  # ---------------------------------------------------------------------------
  # Language-specific quality jobs (format, lint, sanitizers, …) from the profile.
  # ---------------------------------------------------------------------------
  {{CI_EXTRA_JOBS}}
{{#IF_BENCH}}
  # Reproducible performance gate — runs only when the project has a benchmark suite.
  benchmark:
    name: benchmark / reproducible perf
{{#IF_BOOTSTRAP_GUARD}}    needs: bootstrap
    if: needs.bootstrap.outputs.ready == 'true'
{{/IF_BOOTSTRAP_GUARD}}    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      {{CI_SETUP_STEPS}}
      - name: Run the benchmark suite
        shell: bash
        run: {{CMD_BENCH}}
{{/IF_BENCH}}
{{#IF_THREADING}}
  # Data-race / concurrency gate — runs only when the project exposes concurrency.
  {{CI_RACE_JOB}}
{{/IF_THREADING}}
