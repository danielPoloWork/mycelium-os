        "timecode": null
      },
      "target": null,
      "text": null,
      "title": "Replay is manual",
      "variant": "note"
    },
    {
      "blob": null,
      "id": "n6",
      "kind": "paragraph",
      "lang": null,
      "level": null,
      "media_type": null,
