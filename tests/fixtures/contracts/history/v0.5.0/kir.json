          18
        ],
        "page": null,
        "timecode": null
      },
      "target": null,
      "text": null,
      "title": "Quarantine is not deletion",
      "variant": "warning"
    },
    {
      "blob": null,
      "id": "n4",
      "kind": "paragraph",
      "lang": null,
      "level": null,
      "media_type": null,
      "note": null,
