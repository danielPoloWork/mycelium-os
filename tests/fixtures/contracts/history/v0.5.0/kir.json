        "page": null,
        "timecode": null
      },
      "target": null,
      "text": "Failed deliveries retry with exponential backoff. The ceiling is five attempts, after\nwhich the message is quarantined rather than dropped silently.",
      "title": null,
      "variant": null
    },
    {
      "blob": null,
      "id": "n3",
      "kind": "callout",
      "lang": null,
      "level": null,
