        "byte_range": null,
        "cell_range": null,
        "lines": [
          17,
          18
        ],
        "page": null,
        "timecode": null
      },
      "target": null,
      "text": "A quarantined message keeps its provenance and can be replayed once the cause is fixed.",
      "title": null,
      "variant": null
    },
    {
      "blob": null,
      "id": "n5",
      "kind": "callout",
      "lang": null,
