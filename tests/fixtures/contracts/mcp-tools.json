        "required": [
          "snapshot_id",
          "uri",
          "context",
          "stale",
          "path",
          "title",
          "trust_class",
          "verification_status",
          "curated",
          "provenance",
          "fidelity_warnings",
          "content",
          "notice"
        ],
        "type": "object"
      }
