      "INVALID_ARGUMENT",
      "NOT_FOUND",
      "ANCHOR_GONE",
      "SNAPSHOT_UNAVAILABLE",
      "BUDGET_EXCEEDED",
      "INTERNAL"
    ],
    "fields": {
      "ANCHOR_GONE": {
        "nearest": {
          "type": [
            "string",
            "null"
