    "mycelium_fetch": {
      "input": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "default": "chunk",
            "enum": [
              "chunk",
              "section",
              "document"
            ],
            "type": "string"
          },
          "uri": {
            "type": "string"
          }
        },
        "required": [
          "uri"
        ],
        "type": "object"
      },
      "output": {
        "$defs": {
          "JsonValue": {},
          "NonEmptyStr": {
            "minLength": 1,
            "type": "string"
          },
          "Provenance": {
            "additionalProperties": false,
            "properties": {
              "connector": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "connector_version": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "ingested_at": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/UtcDatetime"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "origin": {
                "$ref": "#/$defs/ProvenanceOrigin",
                "default": "authored"
              },
              "source_digest": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Sha256Digest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "source_trust": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SourceTrust"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "source_uri": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "synthesizer": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Synthesizer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "type": "object"
          },
          "ProvenanceOrigin": {
            "enum": [
              "authored",
              "ingested",
              "synthesized"
            ],
            "type": "string"
          },
          "Sha256Digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "SourceTrust": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ],
            "type": "string"
          },
          "Synthesizer": {
            "additionalProperties": false,
            "properties": {
              "model": {
                "$ref": "#/$defs/NonEmptyStr"
